# Copy to .env.local and set a private server-side key. Never use VITE_ for secrets.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_AUDIO_MODEL=google/gemini-2.5-flash

# Frontend build setting; leave empty when frontend and API share an origin.
VITE_API_BASE_URL=

# Backend setting: comma-separated exact origins allowed to call the API from browsers.
CORS_ORIGINS=
